generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "mysql"
  url      = env("DATABASE_URL")
}

model User {
  id          Int            @id @default(autoincrement())
  username    String         @unique
  password    String
  name        String?
  role        Role           @default(OPERATOR)
  createdAt   DateTime       @default(now())
  balance     Float          @default(0)
  cardsSaved  Int            @default(0)
  costPerSave Float          @default(0)
  telegramId  String?
  upiId       String?
  auditLogs   AuditLog[]
  printJobs   PrintHistory[]
}

model Template {
  id            Int            @id @default(autoincrement())
  name          String
  frontTemplate String?
  backTemplate  String?
  dpi           Int            @default(300)
  width         Int            @default(1011)
  height        Int            @default(638)
  status        String         @default("active")
  createdAt     DateTime       @default(now())
  updatedAt     DateTime       @updatedAt
  layouts       Layout[]
  printJobs     PrintHistory[]
}

model Layout {
  id         Int            @id @default(autoincrement())
  templateId Int
  name       String
  layoutJson String         @db.LongText
  createdAt  DateTime       @default(now())
  updatedAt  DateTime       @updatedAt
  mappings   FieldMapping[]
  template   Template       @relation(fields: [templateId], references: [id], onDelete: Cascade)
  printJobs  PrintHistory[]

  @@index([templateId], map: "Layout_templateId_fkey")
}

model FieldMapping {
  id          Int    @id @default(autoincrement())
  layoutId    Int
  fieldName   String
  sourceField String
  layout      Layout @relation(fields: [layoutId], references: [id], onDelete: Cascade)

  @@unique([layoutId, fieldName])
}

model PrintHistory {
  id         Int       @id @default(autoincrement())
  userId     Int
  templateId Int?
  layoutId   Int?
  cardNumber String?
  status     JobStatus @default(PENDING)
  imagePath  String?
  printedAt  DateTime  @default(now())
  layout     Layout?   @relation(fields: [layoutId], references: [id])
  template   Template? @relation(fields: [templateId], references: [id])
  user       User      @relation(fields: [userId], references: [id])

  @@index([layoutId], map: "PrintHistory_layoutId_fkey")
  @@index([templateId], map: "PrintHistory_templateId_fkey")
  @@index([userId], map: "PrintHistory_userId_fkey")
}

model ApiSetting {
  id        Int      @id @default(autoincrement())
  name      String   @default("default")
  baseUrl   String
  authType  AuthType @default(BEARER)
  token     String?
  apiKey    String?
  headers   String?  @db.LongText
  createdAt DateTime @default(now())
}

model DatabaseSetting {
  id           Int      @id @default(autoincrement())
  host         String
  port         Int      @default(3306)
  databaseName String
  username     String
  password     String
  createdAt    DateTime @default(now())
}

model AuditLog {
  id        Int      @id @default(autoincrement())
  userId    Int?
  action    String
  meta      String?  @db.LongText
  createdAt DateTime @default(now())
  user      User?    @relation(fields: [userId], references: [id])

  @@index([userId], map: "AuditLog_userId_fkey")
}

model AppSetting {
  id    Int    @id @default(autoincrement())
  key   String @unique
  value String @db.Text
}

enum Role {
  ADMIN
  OPERATOR
}

enum JobStatus {
  PENDING
  PRINTING
  COMPLETED
  FAILED
}

enum AuthType {
  BEARER
  API_KEY
  BASIC
}
