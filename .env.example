# Copy to .env and fill in your remote MySQL connection.
# Format: mysql://USER:PASSWORD@HOST:PORT/DATABASE
DATABASE_URL="mysql://root:password@localhost:3306/smart_rc"

# Secret used to sign JWT access tokens (change in production).
JWT_SECRET="change-me-to-a-long-random-string"
JWT_EXPIRES_IN="8h"

# Super admin (not stored in DB). The super admin creates users + sets balances.
SUPER_ADMIN_USERNAME="superadmin"
SUPER_ADMIN_PASSWORD="change-me"
SUPER_ADMIN_NAME="Super Admin"
